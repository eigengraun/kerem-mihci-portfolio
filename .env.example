# ============================================================
# Public Site & Browser Analytics
# ============================================================
NEXT_PUBLIC_SITE_URL=https://keremmihci.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-R50Z3J4TZ9

# ============================================================
# Private Admin Authentication & Session Security (Server-Only)
# ============================================================
# Minimum 32-character random secret for HMAC-SHA256 session signing
ADMIN_SESSION_SECRET=replace-with-32-char-minimum-random-secret
# Comma-separated list of authorized administrator emails (REQUIRED in production)
ADMIN_ALLOWED_EMAILS=kerem@keremmihci.com
# Preferred: scrypt password hash (scrypt:<saltHex>:<derivedKeyHex>)
ADMIN_PASSWORD_HASH=
# Alternative fallback passphrase (verified via constant-time HMAC-SHA256 digest)
ADMIN_MASTER_PASSWORD=

# Optional Google OAuth 2.0 credentials for Admin Login / Analytics
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ============================================================
# Cloudflare D1 / R2 / Worker CMS Configuration (Server-Only)
# ============================================================
# Storage operating mode:
#  - "local"      : Local development (allows Wrangler local D1/R2 or .local-d1/.local-r2 simulation)
#  - "staging"    : Staging Cloudflare Worker (local SQLite/R2 fallback strictly disabled; fails closed)
#  - "production" : Production Cloudflare Worker (local SQLite/R2 fallback strictly disabled; fails closed)
CMS_STORAGE_MODE=local

# Content source cutover flag:
#  - "legacy"     : Pre-cutover safe mode (serves canonical src/data/projects.ts without Cloudflare)
#  - "cloudflare" : Post-cutover canonical CMS mode (serves published D1 records via Worker)
CMS_DATA_SOURCE=cloudflare

# Cloudflare Worker API URL & Service Token (REQUIRED in staging and production)
CLOUDFLARE_CMS_API_URL=
CLOUDFLARE_API_SERVICE_TOKEN=
# Optional custom public domain for Cloudflare R2 media bucket
R2_PUBLIC_BASE_URL=https://media.keremmihci.com

# ============================================================
# Google Analytics 4 Data API & Search Console API (Server-Only)
# ============================================================
# Numeric GA4 Property ID (NOT the G-R50Z3J4TZ9 measurement stream ID)
GA4_PROPERTY_ID=
# Search Console site property identifier
GSC_SITE_URL=sc-domain:keremmihci.com
# Google Service Account credentials (either full JSON or email + private key)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
