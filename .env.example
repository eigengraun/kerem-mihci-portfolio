# ============================================================
# Public Site & Browser Analytics
# ============================================================
NEXT_PUBLIC_SITE_URL=https://keremmihci.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================================
# Private Admin Authentication & Session Security (Server-Only)
# ============================================================
# Minimum 32-character random secret for HMAC-SHA256 session signing
ADMIN_SESSION_SECRET=replace-with-32-char-minimum-random-secret
# Comma-separated list of authorized administrator emails
ADMIN_ALLOWED_EMAILS=kerem@keremmihci.com
# Strong master passphrase for Admin CMS login
ADMIN_MASTER_PASSWORD=replace-with-strong-admin-passphrase

# Optional Google OAuth 2.0 credentials for Admin Login / Analytics
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ============================================================
# Cloudflare D1 / R2 / Worker CMS Configuration (Server-Only)
# ============================================================
# Data source mode: "d1" (default, uses D1 SQLite) or "legacy" (static TypeScript fallback)
CMS_DATA_SOURCE=d1
# Optional remote Cloudflare Worker API URL & Service Token
CLOUDFLARE_CMS_API_URL=
CLOUDFLARE_API_SERVICE_TOKEN=
# Optional custom public domain for Cloudflare R2 media bucket
R2_PUBLIC_BASE_URL=https://media.keremmihci.com

# ============================================================
# Google Analytics 4 Data API & Search Console API (Server-Only)
# ============================================================
# Numeric GA4 Property ID (NOT the G-XXXXXXXXXX measurement stream ID)
GA4_PROPERTY_ID=
# Search Console site property identifier
GSC_SITE_URL=sc-domain:keremmihci.com
# Google Service Account credentials (either full JSON or email + private key)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
