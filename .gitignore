# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*service-account*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files & wrangler secrets
.env*
!.env.example
.dev.vars*
/cloudflare/portfolio-api/.dev.vars*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local cloudflare d1 & r2 runtime data
/.local-d1/
/.local-r2/
/.wrangler/
/cloudflare/portfolio-api/.wrangler/
/cloudflare/portfolio-api/node_modules/
*.sqlite
*.sqlite-wal
*.sqlite-shm
