{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kerem-mihci-portfolio-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "PORTFOLIO_DB",
      "database_name": "kerem-portfolio-db",
      "database_id": "local-dev-d1-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PORTFOLIO_MEDIA",
      "bucket_name": "kerem-portfolio-media"
    }
  ],
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "local",
    "PUBLIC_SITE_ORIGIN": "https://keremmihci.com",
    "R2_PUBLIC_BASE_URL": "",
    "ALLOW_CANONICAL_SEED": "true"
  },
  "env": {
    "staging": {
      "name": "kerem-mihci-portfolio-api-staging",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "PORTFOLIO_DB",
          "database_name": "kerem-portfolio-db-staging",
          "database_id": "0efef7a7-cc93-4dc2-8cb7-db28379fe01f",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PORTFOLIO_MEDIA",
          "bucket_name": "kerem-portfolio-media-staging"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "PUBLIC_SITE_ORIGIN": "https://keremmihci.com",
        "R2_PUBLIC_BASE_URL": "",
        "ALLOW_CANONICAL_SEED": "true"
      }
    },
    "production": {
      "name": "kerem-mihci-portfolio-api",
      "workers_dev": false,
      "d1_databases": [
        {
          "binding": "PORTFOLIO_DB",
          "database_name": "kerem-portfolio-db",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PORTFOLIO_MEDIA",
          "bucket_name": "kerem-portfolio-media"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_SITE_ORIGIN": "https://keremmihci.com",
        "R2_PUBLIC_BASE_URL": "",
        "ALLOW_CANONICAL_SEED": "false"
      }
    }
  }
}
